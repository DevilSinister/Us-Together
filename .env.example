# Public browser configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set these to the Supabase project URL and publishable (browser-safe) key.
# Do not commit production credentials or service-role/secret keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local developer preview only. Never enable in production.
DEV_LOGIN_ENABLED=false

# Management tooling only; save the confirmed project reference in .env.local.
# This is not a browser variable or a credential.
SUPABASE_PROJECT_ID=

# Server-only keys are not needed by the Phase 1 browser/auth client.
# Add a Supabase secret key only for a future narrowly authorized server workflow.

# Free Photon/OpenStreetMap search. No API key or billing account required.
LOCATION_SEARCH_ENABLED=true
PHOTON_BASE_URL=https://photon.komoot.io
# Android push (FCM) is dispatched by the database and the fcm-dispatch Edge Function,
# not by the web server. FIREBASE_SERVICE_ACCOUNT_JSON and PUSH_DISPATCH_SECRET live only
# in Supabase Edge Function secrets; see docs/PHASE8_OPERATIONS.md.
#
# The Android APK reads its own public build settings from the shell, never from this
# file: WIDGET_SUPABASE_URL, WIDGET_SUPABASE_PUBLISHABLE_KEY, WIDGET_WEB_BASE_URL,
# WIDGET_FIREBASE_APP_ID, WIDGET_FIREBASE_SENDER_ID, WIDGET_FIREBASE_API_KEY,
# WIDGET_FIREBASE_PROJECT_ID, and the release keystore variables. See android-widget/README.md.
