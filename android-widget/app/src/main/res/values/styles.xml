<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.UsTogether" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:colorControlNormal">@color/muted_foreground</item>
        <item name="android:textColorPrimary">@color/foreground</item>
        <item name="android:textColorSecondary">@color/muted_foreground</item>
        <item name="android:textColorHint">@color/muted_foreground</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <!-- We ship a real dark palette, so the platform must not auto-invert
             the warm one it would otherwise mangle. -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
    <!-- Shown for the instant before Chrome takes over the Trusted Web Activity. -->
    <style name="Theme.UsTogether.Launcher" parent="Theme.UsTogether">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Type scale. Serif for display, headline and title only: the serif is
         what tells the story, and controls stay sans. The old screens passed
         bare ints to setTextSize - 30, 28, 23, 22, 18, 16, 15, 14, 13 - with no
         scale behind them and no styles at all. -->
    <style name="Text.Display" parent="">
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:lineSpacingMultiplier">1.08</item>
    </style>
    <style name="Text.Headline" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
    </style>
    <style name="Text.Title" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/foreground</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>
    <style name="Text.Lede" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/muted_foreground</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>
    <style name="Text.Label" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/foreground</item>
    </style>
    <style name="Text.Eyebrow" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="Text.Caption" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted_foreground</item>
    </style>

    <!-- Controls. textAllCaps is false everywhere: the platform Button shouts
         by default and the web never does. -->
    <style name="Widget.UsTogether.Button" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">@dimen/space_5</item>
        <item name="android:paddingRight">@dimen/space_5</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.UsTogether.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_text_primary</item>
    </style>
    <style name="Widget.UsTogether.Button.Outline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/button_text_surface</item>
    </style>
    <style name="Widget.UsTogether.Button.Ghost">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/button_text_surface</item>
    </style>
    <style name="Widget.UsTogether.Button.Danger">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/danger</item>
    </style>
    <style name="Widget.UsTogether.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/space_3</item>
    </style>
    <style name="Widget.UsTogether.Field" parent="">
        <item name="android:background">@drawable/shape_field</item>
        <item name="android:minHeight">@dimen/field_height</item>
        <item name="android:paddingLeft">@dimen/space_4</item>
        <item name="android:paddingRight">@dimen/space_4</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:textColorHint">@color/muted_foreground</item>
    </style>
    <style name="Widget.UsTogether.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/stroke_hairline</item>
        <item name="android:background">@color/border</item>
    </style>
</resources>
