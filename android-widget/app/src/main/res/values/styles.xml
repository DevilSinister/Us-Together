<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UsTogether" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/brand</item>
    </style>
    <!-- Shown for the instant before Chrome takes over the Trusted Web Activity. -->
    <style name="Theme.UsTogether.Launcher" parent="Theme.UsTogether">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
