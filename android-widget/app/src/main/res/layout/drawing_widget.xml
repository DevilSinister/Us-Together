<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FBF7F3" android:padding="8dp">
    <ImageView android:id="@+id/drawing_image" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitCenter"
        android:contentDescription="Latest drawing from your partner"/>
    <TextView android:id="@+id/drawing_empty" android:layout_width="match_parent"
        android:layout_height="match_parent" android:gravity="center" android:textColor="#542B34"
        android:textSize="16sp" android:text="Open Us Together to connect your drawings."/>
</FrameLayout>
